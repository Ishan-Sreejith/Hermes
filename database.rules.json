{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": true,
      ".write": true
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "true"
      }
    },
    "users": {
      "$username": {
        ".read": true,
        ".write": "true"
      }
    },
    "messages": {
      "$chatKey": {
        ".read": true,
        ".indexOn": ["ts"],
        "$msgId": {
          ".write": "true"
        }
      }
    }
  }
}
