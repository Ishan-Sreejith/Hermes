{
  "rules": {
    ".read": true,
    ".write": true,
    "rooms": {
      ".read": true,
      ".write": true,
      "$room": {
        ".validate": "newData.isString() || newData.hasChildren(['created_at']) || !newData.exists()"
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "true"
      }
    },
    "users": {
      "$username": {
        ".read": true,
        ".write": "true"
      }
    },
    "messages": {
      "$chatKey": {
        ".read": true,
        ".indexOn": ["ts"],
        "$msgId": {
          ".write": "true"
        }
      }
    },
    "signaling": {
      ".read": true,
      ".write": true
    }
  }
}
